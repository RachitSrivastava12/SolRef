# ─── SolRef environment variables ───────────────────────────────────────────
# Copy this file to ".env.local" for local dev. On Vercel, add these under
# Project → Settings → Environment Variables (do NOT commit real values).

# ── FRONTEND (browser-visible — must be prefixed VITE_) ──
# Your Solana RPC endpoint for the live stats bar. Public endpoint works but is
# rate-limited; use your own (Helius/QuickNode/etc) for a smooth grant demo.
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com

# ── BACKEND (server-only — used by /api/quiz, NEVER exposed to the browser) ──
# OpenRouter API key for DeepSeek-powered quiz generation.
OPENROUTER_API_KEY=sk-or-your-key-here
# Optional: override the model. Default is deepseek/deepseek-v4-flash.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
